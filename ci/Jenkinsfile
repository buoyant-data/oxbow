/*
 * This Jenkinsfile is for internal use
 */

pipeline {
  agent none
  options {
    retry(1)
    // This timeout can include wait time when executors are occupied, so using
    // something arbitrarily high for the whole pipeline
    timeout(time: 6, unit: 'HOURS')
    parallelsAlwaysFailFast()
  }

  stages {
    stage('Check') {
      agent { label 'rust' }
      steps {
        sh 'cargo fmt --check'
      }
    }

    stage('Build') {
      options {
        timeout(time: 2, unit: 'HOURS')
      }
      parallel {
        stage('FreeBSD') {
          agent { label 'freebsd' }
          steps {
            sh './ci/setup.sh'
            // protoc-bin-vendored has no FreeBSD binary, so use the system protoc
            sh 'PROTOC="$(command -v protoc)" gmake -C crates build'
            sh 'PROTOC="$(command -v protoc)" gmake -C lambdas build'
          }
        }

        stage('Linux') {
          agent { label 'linux' }
          steps {
            sh './ci/setup.sh'
            sh 'gmake -C crates build'
            sh 'gmake -C lambdas build'
          }
        }
      }
    }

    stage('Test') {
      options {
        timeout(time: 2, unit: 'HOURS')
      }
      parallel {
        stage('FreeBSD') {
          agent { label 'freebsd' }
          steps {
            sh './ci/setup.sh'
            // protoc-bin-vendored has no FreeBSD binary, so use the system protoc
            sh 'PROTOC="$(command -v protoc)" gmake -C crates test'
          }
        }

        stage('Linux') {
          agent { label 'linux' }
          steps {
            sh './ci/setup.sh'
            sh 'gmake -C crates test'
            sh 'gmake -C lambdas test'
          }
          post {
            success {
              // Publish from the node that produced the report: a stage-level
              // post runs under `agent none` and cannot use junit there.
              junit testResults: 'target/nextest/ci/junit.xml', allowEmptyResults: false
            }
          }
        }
      }
    }

    stage('Acceptance') {
      options {
        timeout(time: 1, unit: 'HOURS')
      }
      // LocalStack runs the lambdas in containers, so this stage needs a Linux
      // agent with a container engine. It is not run on FreeBSD.
      agent { label 'linux' }
      steps {
        sh './ci/setup.sh'
        sh 'gmake acceptance-build'
        sh 'gmake acceptance'
      }
    }

    stage('Release') {
      failFast true
      when { branch 'main' }
      options {
        timeout(time: 2, unit: 'HOURS')
      }
      matrix {
        axes {
          axis {
            name 'PLATFORM'
            //values 'x86-64', 'arm64'
            values 'x86-64'
          }
          axis {
            name 'LAMBDA'
            values 'oxbow-lambda', 'sqs-ingest', 'file-loader', 'cdf-to-csv', 'group-events', 'auto-tag'
          }
        }
        stages {
          stage('Build') {
            // The zig builds don't work very well on FreeBSD
            agent { label 'linux' }
            steps {
              sh "cargo lambda build --${PLATFORM} --package ${LAMBDA} --lambda-dir target/lambda/${PLATFORM} --release --output-format zip"
              sh "mv target/lambda/${PLATFORM}/${LAMBDA}/bootstrap.zip target/lambda/${LAMBDA}-${PLATFORM}.zip"
              archiveArtifacts artifacts: "target/lambda/${LAMBDA}-${PLATFORM}.zip", fingerprint: true, onlyIfSuccessful: true
            }
          }
        }
      }
    }
  }
}

// vim: ft=groovy sw=2 ts=2 et
